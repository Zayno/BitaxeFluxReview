(version 1)

# PCBWay - 6 Layer / 1 oz copper / Normal process
# Intended for a standard-cost engineering prototype.
# Based on PCBWay published 6-layer / 1 oz normal-process capabilities.
# Impedance constraints are intentionally NOT included.

# ---------------- Trace width / spacing ----------------

# Outer layers, 1 oz: 5/6 mil normal process
(rule "PCBWay 6L 1oz - Outer trace width and spacing"
    (constraint track_width (min 0.127mm))
    (constraint clearance (min 0.1524mm))
    (layer outer)
    (condition "A.Type == 'track'"))

# Inner layers, 1 oz: 4/5 mil normal process
(rule "PCBWay 6L 1oz - Inner trace width and spacing"
    (constraint track_width (min 0.1016mm))
    (constraint clearance (min 0.127mm))
    (layer inner)
    (condition "A.Type == 'track'"))

# ---------------- Drill / hole sizes ----------------

# Normal-process CNC drill minimum for multilayer prototype
(rule "PCBWay 6L - Via drill size"
    (constraint hole_size (min 0.20mm))
    (condition "A.Type == 'via'"))

(rule "PCBWay 6L - PTH drill size"
    (constraint hole_size (min 0.20mm) (max 6.5mm))
    (condition "A.Type != 'Via' && A.isPlated()"))

# Keep small NPTHs out of the low-cost process unless the connector requires them
(rule "PCBWay 6L - Minimum NPTH drill"
    (constraint hole_size (min 0.50mm))
    (condition "A.Type == 'pad' && !A.isPlated()"))

# Slots from PCBWay normal process guidance
(rule "PCBWay 6L - Minimum plated slot width"
    (constraint hole_size (min 0.50mm))
    (condition "(A.Hole_Size_X != A.Hole_Size_Y) && A.isPlated()"))

(rule "PCBWay 6L - Minimum non-plated slot width"
    (constraint hole_size (min 0.80mm))
    (condition "(A.Hole_Size_X != A.Hole_Size_Y) && !A.isPlated()"))

# ---------------- Annular ring ----------------

# 1 oz normal process: via annular ring >= 5 mil
(rule "PCBWay 6L 1oz - Via annular ring"
    (constraint annular_width (min 0.127mm))
    (condition "A.Type == 'via'"))

# 1 oz normal process: component-hole annular ring >= 10 mil
(rule "PCBWay 6L 1oz - Component PTH annular ring"
    (constraint annular_width (min 0.25mm))
    (condition "A.Type == 'Pad' && A.isPlated()"))

# ---------------- Hole spacing ----------------

# PCBWay standard 1 oz guidance: different-net PTH spacing >= 0.45 mm
(rule "PCBWay 6L - PTH to PTH hole spacing"
    (constraint hole_to_hole (min 0.45mm))
    (condition "A.Type == 'pad' && B.Type == 'pad' && A.isPlated() && B.isPlated() && A.Net != B.Net"))

# PCBWay standard 1 oz guidance: via hole spacing >= 0.30 mm
(rule "PCBWay 6L - Via to via hole spacing"
    (constraint hole_to_hole (min 0.30mm))
    (condition "A.Type == 'via' && B.Type == 'via'"))

# ---------------- Hole to copper ----------------

# 6-layer normal process: inner-layer hole-to-conductor isolation >= 8 mil
# Applied globally as a conservative 6-layer fabrication rule.
(rule "PCBWay 6L - Hole to copper clearance"
    (constraint hole_clearance (min 0.2032mm)))

# Explicit NPTH mechanical-hole to copper clearance
(rule "PCBWay 6L - NPTH to copper clearance"
    (constraint hole_clearance (min 0.20mm))
    (condition "A.Pad_Type == 'NPTH, mechanical'"))

# ---------------- Board edge ----------------

# PCBWay normal CNC routing process: copper/trace to routed edge >= 0.25 mm
(rule "PCBWay 6L - Copper to board edge"
    (constraint edge_clearance (min 0.25mm)))

# ---------------- Silkscreen ----------------

(rule "PCBWay - Minimum silkscreen text"
    (constraint text_thickness (min 0.15mm))
    (constraint text_height (min 0.80mm))
    (layer "?.Silkscreen"))

(rule "PCBWay - Pad to silkscreen"
    (constraint silk_clearance (min 0.15mm))
    (layer outer)
    (condition "A.Type == 'pad' && (B.Type == 'text' || B.Type == 'graphic')"))
(rule "U3 U7 thermal holes"
    (condition "A.Type == 'Pad' && (A.memberOfFootprint('U3') || A.memberOfFootprint('U7')) && A.Pad_Number == '41'")
    (constraint annular_width (min 0.127mm)))
